// Incipit Play · idioma da interface. O texto do app é escrito em português direto nos QML, dentro de root.t("...");
// em inglês, root.t troca pelo par deste dicionário. Trocar o idioma muda a tela na hora (sem reabrir) e a escolha
// fica salva neste PC (QSettings do app, grupo "idioma"). Sem escolha salva, português.
// Conferência: python ferramentas/conferir_traducao.py (todo root.t precisa de par aqui).
// As telas herdadas do chiaki-ng ("Mais ajustes" e o menu durante o jogo) continuam em inglês nos dois idiomas.
import QtQuick
import QtCore

QtObject {
    id: l

    property Settings guardado: Settings {
        category: "idioma"
        property string lingua: ""
    }
    property string idioma: guardado.lingua === "en" ? "en" : "pt"
    readonly property bool en: idioma === "en"
    function escolher(i) { idioma = i; guardado.lingua = i; }

    function t(s) {
        if (!en) return s;
        const v = ingles[s];
        if (v !== undefined) return v;
        // motivo que o gravador manda junto: "O clipe não salvou: <motivo>."
        const comeco = "O clipe não salvou: ";
        if (String(s).startsWith(comeco)) {
            const motivo = String(s).slice(comeco.length).replace(/\.$/, "");
            return "The clip didn't save: " + (ingles[motivo] !== undefined ? ingles[motivo] : motivo) + ".";
        }
        return s;
    }

